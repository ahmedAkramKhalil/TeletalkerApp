    <!-- tutorial -->
    <string name="booking_tutorial_title_1">Get a free booking page</string>
    <string name="booking_tutorial_body_1">TeleTalker gives you a public page at teletalker-21348.web.app/book/&lt;your-slug&gt;. Share it on cards, on socials, anywhere.</string>
    <string name="booking_tutorial_title_2">Customers book in seconds</string>
    <string name="booking_tutorial_body_2">They pick a service, pick a time slot inside your hours, and submit. No accounts. No friction.</string>
    <string name="booking_tutorial_title_3">Your phone calls them back</string>
    <string name="booking_tutorial_body_3">~30 seconds after booking, TeleTalker dials the customer from your own device. The AI confirms by name.</string>
    <string name="booking_tutorial_title_4">Manage from anywhere</string>
    <string name="booking_tutorial_body_4">Change services, hours, and booking mode here on your phone — or from the web dashboard. Both stay in sync.</string>

