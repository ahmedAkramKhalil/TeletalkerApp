<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            android:padding="24dp">

            <!-- Dialog Title -->
            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Schedule AI Call"
                android:textColor="@color/gunmetalTextGray"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Phone Number Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:drawablePadding="12dp"
                android:drawableTint="@color/gunmetalTextGray"
                android:textColorHint="@color/black"
                android:textSize="14sp"
                app:endIconMode="custom"


                app:layout_constraintHorizontal_bias="0.0"
                app:startIconDrawable="@android:drawable/ic_menu_call">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_back"
                    android:hint="       Phone Number"
                    android:inputType="phone"


                    android:maxLines="1"

                    android:paddingStart="24dp" />
            </com.google.android.material.textfield.TextInputLayout>


            <!-- Contact Name Input (Auto-filled or manual) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilContactName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="      Contact Name (Optional)"

                app:startIconDrawable="@android:drawable/ic_menu_myplaces">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContactName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_back"
                    android:inputType="textPersonName"

                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ⭐ ADD THIS: Purpose Input -->


            <!-- Date and Time Selection Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <!-- Date Picker -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="      Date"
                    app:startIconDrawable="@android:drawable/ic_menu_my_calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edit_text_back"
                        android:clickable="true"
                        android:focusable="false"

                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Time Picker -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="      Time"
                    app:startIconDrawable="@android:drawable/ic_menu_recent_history">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edit_text_back"
                        android:clickable="true"
                        android:focusable="false"

                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Duration Selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Call Duration"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip5Min"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 min" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip10Min"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="10 min" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip15Min"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 min" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip30Min"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30 min" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip60Min"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60 min" />
            </com.google.android.material.chip.ChipGroup>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPurpose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="      Call Purpose"
                app:startIconDrawable="@android:drawable/ic_menu_info_details">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPurpose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_back"
                    android:hint="                          e.g., Follow up on order, Schedule appointment"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>


            <!-- AI Conversation Notes -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConversationNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clipToPadding="true"
                android:hint="      "
                android:paddingTop="23dp"
                app:counterEnabled="true"
                app:counterMaxLength="500"
                app:helperText="Tell the AI what to discuss during the call"
                app:startIconDrawable="@android:drawable/ic_dialog_info">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConversationNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:background="@drawable/edit_text_back"
                    android:gravity="top|start"
                    android:hint="Example: Greet the customer, ask about their order status, and offer help with any issues..."

                    android:inputType="textMultiLine"
                    android:maxLength="500"
                    android:maxLines="5"
                    android:minLines="3"
                    android:paddingStart="23dp"

                    android:paddingTop="24dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Repeat Options (Optional - Future Feature) -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchRepeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Repeat this call"
                android:visibility="gone" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal"

                android:paddingBottom="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Cancel"
                    android:textColor="@color/purple_500" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/purple_500"
                    android:foregroundTint="@color/purple_500"
                    android:text="Schedule Call" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>