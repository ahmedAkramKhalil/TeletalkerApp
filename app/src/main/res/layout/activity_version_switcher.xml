<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Loading Progress -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Main Content -->
    <ScrollView
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <!-- Version Badge Icon -->
                    <ImageView
                        android:id="@+id/ivVersionBadge"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_lite_badge"
                        android:layout_marginBottom="16dp" />

                    <!-- Version Title -->
                    <TextView
                        android:id="@+id/tvVersionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lite Plan"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="8dp" />

                    <!-- Version Description -->
                    <TextView
                        android:id="@+id/tvVersionDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Free • Limited Features"
                        android:textSize="16sp"
                        android:textColor="#757575" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Subscription Info Card (for Standard users) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSubscriptionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="2dp"
                app:strokeColor="#6200EE">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋 Subscription Details"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="16dp" />

                    <!-- Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Status"
                            android:textSize="14sp"
                            android:textColor="#757575" />

                        <TextView
                            android:id="@+id/tvSubscriptionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#4CAF50" />
                    </LinearLayout>

                    <!-- Price -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Price"
                            android:textSize="14sp"
                            android:textColor="#757575" />

                        <TextView
                            android:id="@+id/tvMonthlyPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$10.00/month"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#6200EE" />
                    </LinearLayout>

                    <!-- Next Billing -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Next Billing"
                            android:textSize="14sp"
                            android:textColor="#757575" />

                        <TextView
                            android:id="@+id/tvNextBilling"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nov 02, 2025"
                            android:textSize="14sp"
                            android:textColor="#212121" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Features Card (for Lite users) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFeatures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/card_background_light"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Standard Plan Features"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="16dp" />

                    <!-- Feature 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textSize="18sp"
                            android:textColor="#4CAF50"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Unlimited call recording"
                            android:textSize="15sp"
                            android:textColor="#212121" />
                    </LinearLayout>

                    <!-- Feature 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textSize="18sp"
                            android:textColor="#4CAF50"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Advanced AI features"
                            android:textSize="15sp"
                            android:textColor="#212121" />
                    </LinearLayout>

                    <!-- Feature 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textSize="18sp"
                            android:textColor="#4CAF50"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cloud backup &amp; sync"
                            android:textSize="15sp"
                            android:textColor="#212121" />
                    </LinearLayout>

                    <!-- Feature 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textSize="18sp"
                            android:textColor="#4CAF50"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Priority support"
                            android:textSize="15sp"
                            android:textColor="#212121" />
                    </LinearLayout>

                    <!-- Feature 5 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textSize="18sp"
                            android:textColor="#4CAF50"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No ads"
                            android:textSize="15sp"
                            android:textColor="#212121" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->

            <!-- Switch Version Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwitchVersion"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Upgrade to Standard"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_upgrade"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:layout_marginBottom="12dp"
                style="@style/Widget.Material3.Button" />

            <!-- View Invoices Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewInvoices"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="View Invoices"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_invoice"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:layout_marginBottom="12dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- Cancel Subscription Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelSubscription"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Cancel Subscription"
                android:textSize="15sp"
                android:textColor="#F44336"
                app:cornerRadius="12dp"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.TextButton" />

            <!-- Info Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Cancel anytime • No hidden fees"
                android:textSize="13sp"
                android:textColor="#9E9E9E"
                android:layout_gravity="center"
                android:layout_marginTop="16dp" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>