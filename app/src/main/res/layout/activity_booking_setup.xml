<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lite_background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/lite_surface"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="@string/back"
            android:scaleX="-1"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/booking_page"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveBtn"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/colorPrimary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBar" />

    <ScrollView
        android:id="@+id/formScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/headerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Share link card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/shareCardWrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/lite_card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:id="@+id/shareCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/shareTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/booking_share_card_title"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/shareBusinessLine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/shareSlugLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@color/light_blue"
                            android:fontFamily="monospace"
                            android:padding="10dp"
                            android:textColor="@color/colorPrimary"
                            android:textIsSelectable="true"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="end">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/copyBtn"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/copy"
                                android:textAllCaps="false"
                                android:textColor="@color/colorPrimary"
                                android:layout_marginEnd="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/openBtn"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/open"
                                android:textAllCaps="false"
                                android:textColor="@color/colorPrimary"
                                app:strokeColor="@color/colorPrimary"
                                android:layout_marginEnd="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/shareBtn"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/share"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:backgroundTint="@color/colorPrimary"
                                app:cornerRadius="10dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/shareEmptyHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/booking_share_empty_hint"
                        android:textColor="@color/text_gray"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tutorialBtn"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="start|center_vertical"
                        android:text="@string/booking_open_tutorial"
                        android:textAllCaps="false"
                        android:textColor="@color/colorPrimary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- View bookings CTA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/viewBookingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/booking_section_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/booking_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/avatar_bg" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/bookings_view_button"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/bookings_view_subtitle"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="22sp"
                        android:text="›" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Profile -->
            <TextView style="@style/BookingSectionTitle" android:text="@string/booking_section_profile" />

            <androidx.cardview.widget.CardView style="@style/BookingSectionCard">
                <LinearLayout style="@style/BookingSectionInner">

                    <TextView style="@style/BookingFieldLabel" android:text="@string/booking_slug_label" />
                    <EditText android:id="@+id/slugEt" style="@style/BookingInput"
                        android:hint="my-shop" android:inputType="textNoSuggestions" android:singleLine="true" />

                    <TextView style="@style/BookingFieldLabel" android:text="@string/booking_name_label"
                        android:layout_marginTop="14dp" />
                    <EditText android:id="@+id/nameEt" style="@style/BookingInput"
                        android:hint="@string/booking_name_hint" android:singleLine="true" />

                    <TextView style="@style/BookingFieldLabel" android:text="@string/booking_timezone_label"
                        android:layout_marginTop="14dp" />
                    <Spinner android:id="@+id/timezoneSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/booking_input_bg" />

                    <TextView style="@style/BookingFieldLabel" android:text="@string/booking_desc_label"
                        android:layout_marginTop="14dp" />
                    <EditText android:id="@+id/descEt" style="@style/BookingInput"
                        android:hint="@string/booking_desc_hint"
                        android:minLines="2"
                        android:gravity="top|start"
                        android:inputType="textMultiLine" />

                    <TextView style="@style/BookingFieldLabel" android:text="@string/booking_phone_label"
                        android:layout_marginTop="14dp" />
                    <EditText android:id="@+id/phoneEt" style="@style/BookingInput"
                        android:hint="+1 555-123-4567" android:inputType="phone" android:singleLine="true" />

                    <TextView style="@style/BookingFieldLabel" android:text="@string/booking_address_label"
                        android:layout_marginTop="14dp" />
                    <EditText android:id="@+id/addressEt" style="@style/BookingInput"
                        android:singleLine="true" />

                    <TextView style="@style/BookingFieldLabel" android:text="@string/booking_website_label"
                        android:layout_marginTop="14dp" />
                    <EditText android:id="@+id/websiteEt" style="@style/BookingInput"
                        android:hint="https://" android:inputType="textUri" android:singleLine="true" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Booking page template -->
            <TextView style="@style/BookingSectionTitle" android:text="@string/booking_section_template" />
            <androidx.cardview.widget.CardView style="@style/BookingSectionCard">
                <LinearLayout style="@style/BookingSectionInner">
                    <TextView style="@style/BookingHint"
                        android:paddingStart="0dp"
                        android:text="@string/booking_section_template_hint" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/templatePickerRv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="0dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Look & feel -->
            <TextView style="@style/BookingSectionTitle" android:text="@string/booking_section_look" />
            <androidx.cardview.widget.CardView style="@style/BookingSectionCard">
                <LinearLayout style="@style/BookingSectionInner">

                    <TextView style="@style/BookingFieldLabel" android:text="@string/booking_cover_label" />
                    <EditText android:id="@+id/coverEt" style="@style/BookingInput"
                        android:hint="https://&#8230;" android:inputType="textUri" android:singleLine="true" />
                    <ImageView android:id="@+id/coverPreview"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/booking_input_inner_bg"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@string/booking_cover_label" />
                    <TextView style="@style/BookingHint"
                        android:layout_marginTop="6dp"
                        android:text="@string/booking_cover_hint" />

                    <TextView style="@style/BookingFieldLabel"
                        android:layout_marginTop="14dp"
                        android:text="@string/booking_logo_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView android:id="@+id/logoPreview"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/booking_input_inner_bg"
                            android:scaleType="centerCrop"
                            android:contentDescription="@string/booking_logo_label" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/logoChooseBtn"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/booking_logo_choose" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/logoRemoveBtn"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/booking_logo_remove"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/logoUploadProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <!-- Keep the legacy EditText as a hidden URL fallback so the
                         existing TextWatcher / save path doesn't break. The new
                         Choose-logo button writes the resolved URL into it. -->
                    <EditText android:id="@+id/logoEt" style="@style/BookingInput"
                        android:hint="https://&#8230;"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:visibility="gone" />

                    <TextView style="@style/BookingHint"
                        android:layout_marginTop="6dp"
                        android:text="@string/booking_logo_hint" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- AI agent -->
            <TextView style="@style/BookingSectionTitle" android:text="@string/booking_section_agent" />
            <androidx.cardview.widget.CardView style="@style/BookingSectionCard">
                <LinearLayout style="@style/BookingSectionInner">

                    <TextView style="@style/BookingFieldLabel"
                        android:text="@string/booking_agent_label" />
                    <TextView style="@style/BookingHint"
                        android:layout_marginBottom="8dp"
                        android:paddingStart="0dp"
                        android:text="@string/booking_agent_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/agentCurrentTv"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/booking_input_bg"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:text="@string/booking_agent_none"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chooseAgentBtn"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:text="@string/booking_agent_choose"
                            android:textAllCaps="false"
                            android:textColor="@color/colorPrimary"
                            app:strokeColor="@color/colorPrimary" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- AI script & personality -->
            <TextView style="@style/BookingSectionTitle" android:text="@string/booking_section_ai_script" />
            <androidx.cardview.widget.CardView style="@style/BookingSectionCard">
                <LinearLayout style="@style/BookingSectionInner">

                    <TextView style="@style/BookingFieldLabel" android:text="@string/booking_ai_tone_label" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/aiToneChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:singleLine="true"
                        app:singleSelection="true"
                        app:selectionRequired="true">
                        <com.google.android.material.chip.Chip
                            android:id="@+id/toneWarm"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/booking_ai_tone_warm" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/toneProfessional"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/booking_ai_tone_professional" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/toneCasual"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/booking_ai_tone_casual" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/toneFriendly"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/booking_ai_tone_friendly" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- First message -->
                    <TextView style="@style/BookingFieldLabel"
                        android:text="@string/booking_ai_first_msg_label" />
                    <TextView style="@style/BookingHint"
                        android:paddingStart="0dp"
                        android:text="@string/booking_ai_first_msg_hint" />
                    <EditText
                        android:id="@+id/aiFirstMessageEt"
                        style="@style/BookingInput"
                        android:gravity="top|start"
                        android:minLines="3"
                        android:maxLines="6"
                        android:inputType="textMultiLine|textCapSentences"
                        android:hint="@string/booking_ai_first_msg_default_preview" />
                    <LinearLayout
                        android:id="@+id/firstMsgVarChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="14dp"
                        android:orientation="horizontal" />

                    <!-- Voicemail -->
                    <TextView style="@style/BookingFieldLabel"
                        android:text="@string/booking_ai_voicemail_label" />
                    <TextView style="@style/BookingHint"
                        android:paddingStart="0dp"
                        android:text="@string/booking_ai_voicemail_hint" />
                    <EditText
                        android:id="@+id/aiVoicemailEt"
                        style="@style/BookingInput"
                        android:gravity="top|start"
                        android:minLines="2"
                        android:maxLines="4"
                        android:inputType="textMultiLine|textCapSentences"
                        android:hint="@string/booking_ai_voicemail_default_preview" />
                    <LinearLayout
                        android:id="@+id/voicemailVarChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="14dp"
                        android:orientation="horizontal" />

                    <!-- Rules list -->
                    <TextView style="@style/BookingFieldLabel"
                        android:text="@string/booking_ai_rules_label" />
                    <TextView style="@style/BookingHint"
                        android:paddingStart="0dp"
                        android:text="@string/booking_ai_rules_hint" />
                    <LinearLayout
                        android:id="@+id/aiRulesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/aiAddRuleBtn"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:text="@string/booking_ai_rule_add"
                        android:textAllCaps="false"
                        android:textColor="@color/colorPrimary" />

                    <!-- Advanced override -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/aiAdvancedToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/booking_ai_advanced_toggle"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/aiAdvancedGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView style="@style/BookingHint"
                            android:paddingStart="0dp"
                            android:text="@string/booking_ai_advanced_hint" />
                        <EditText
                            android:id="@+id/aiAdvancedEt"
                            style="@style/BookingInput"
                            android:gravity="top|start"
                            android:minLines="6"
                            android:maxLines="14"
                            android:inputType="textMultiLine"
                            android:hint="@string/booking_ai_advanced_label" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Services -->
            <TextView style="@style/BookingSectionTitle" android:text="@string/booking_section_services" />
            <androidx.cardview.widget.CardView style="@style/BookingSectionCard">
                <LinearLayout style="@style/BookingSectionInner">
                    <LinearLayout android:id="@+id/servicesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addServiceBtn"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/booking_add_service"
                        android:textAllCaps="false"
                        android:textColor="@color/colorPrimary"
                        app:icon="@drawable/ic_add"
                        app:iconTint="@color/colorPrimary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Hours -->
            <TextView style="@style/BookingSectionTitle" android:text="@string/booking_section_hours" />
            <androidx.cardview.widget.CardView style="@style/BookingSectionCard">
                <LinearLayout android:id="@+id/hoursContainer"
                    style="@style/BookingSectionInner" />
            </androidx.cardview.widget.CardView>

            <!-- Booking mode -->
            <TextView style="@style/BookingSectionTitle" android:text="@string/booking_section_mode" />
            <androidx.cardview.widget.CardView style="@style/BookingSectionCard">
                <LinearLayout style="@style/BookingSectionInner">
                    <RadioGroup android:id="@+id/modeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton android:id="@+id/modeInterval"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/booking_mode_interval"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                        <TextView style="@style/BookingHint"
                            android:text="@string/booking_mode_interval_desc" />

                        <RadioButton android:id="@+id/modeSlots"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/booking_mode_slots"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                        <TextView style="@style/BookingHint"
                            android:text="@string/booking_mode_slots_desc" />

                        <RadioButton android:id="@+id/modeAnytime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/booking_mode_anytime"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                        <TextView style="@style/BookingHint"
                            android:text="@string/booking_mode_anytime_desc" />
                    </RadioGroup>

                    <LinearLayout android:id="@+id/intervalRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">
                        <TextView style="@style/BookingFieldLabel"
                            android:text="@string/booking_slot_interval" />
                        <LinearLayout android:id="@+id/intervalChips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <TextView android:id="@+id/slotsHint"
                        style="@style/BookingHint"
                        android:layout_marginTop="14dp"
                        android:text="@string/booking_mode_slots_hint"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View android:layout_width="match_parent" android:layout_height="32dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
