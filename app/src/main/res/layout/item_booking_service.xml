<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/booking_input_bg"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/serviceName"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="sans-serif-medium"
            android:hint="@string/booking_service_name_hint"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/serviceRemove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="@string/remove"
            app:tint="@color/text_gray" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/serviceDuration"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/booking_input_inner_bg"
            android:hint="@string/booking_duration_hint"
            android:inputType="number"
            android:paddingHorizontal="10dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <View android:layout_width="8dp" android:layout_height="0dp" />

        <EditText
            android:id="@+id/servicePrice"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/booking_input_inner_bg"
            android:hint="@string/booking_price_hint"
            android:inputType="numberDecimal"
            android:paddingHorizontal="10dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/serviceDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/booking_input_inner_bg"
        android:hint="@string/booking_service_description_hint"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />
</LinearLayout>
