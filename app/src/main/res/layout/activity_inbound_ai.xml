<?xml version="1.0" encoding="utf-8"?>
<!--
  Inbound AI receptionist editor — mirrors the visual language of fragment_settings.xml.
  Uses MaterialCardView with @color/darkMidnightBlue surfaces so it adapts to
  light/dark theme automatically. Generous vertical rhythm:
   • 24 dp gap above each section title
   • 12 dp gap between title and its first input
   • 14 dp gap between subsequent inputs inside the same card
   • 16 dp gap between cards
   • 22 dp internal padding (same as settings cards)
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/inboundToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?android:attr/colorBackground"
            app:contentInsetStartWithNavigation="0dp"
            app:titleTextColor="@color/gunmetalTextGray" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ProgressBar
                android:id="@+id/inboundLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="64dp"
                android:indeterminateTint="@color/colorPrimary" />

            <LinearLayout
                android:id="@+id/inboundAgentScopeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="4dp"
                android:visibility="gone">

                <!-- ============ Agent picker card ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/darkMidnightBlue"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/inbound_ai_agent_label"
                            android:textColor="@color/gunmetalTextGray"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/inbound_ai_agent_hint"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/inboundAgentSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/booking_input_bg" />
                        <TextView
                            android:id="@+id/inboundAgentIdSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/text_gray_hint"
                            android:textSize="11sp"
                            tools:text="agent_xxxxx" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ Tone + script card ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/darkMidnightBlue"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <!-- Tone -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/booking_ai_tone_label"
                            android:textColor="@color/gunmetalTextGray"
                            android:textSize="14sp" />
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/inboundToneChips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:singleLine="true"
                            app:singleSelection="true"
                            app:selectionRequired="true">
                            <com.google.android.material.chip.Chip
                                android:id="@+id/inboundToneWarm"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/booking_ai_tone_warm" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/inboundToneProfessional"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/booking_ai_tone_professional" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/inboundToneCasual"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/booking_ai_tone_casual" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/inboundToneFriendly"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/booking_ai_tone_friendly" />
                        </com.google.android.material.chip.ChipGroup>

                        <!-- First message -->
                        <View android:layout_width="match_parent" android:layout_height="24dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/inbound_ai_first_msg_label"
                            android:textColor="@color/gunmetalTextGray"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/inbound_ai_first_msg_hint"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp" />
                        <EditText
                            android:id="@+id/inboundFirstMessageEt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/booking_input_bg"
                            android:gravity="top|start"
                            android:hint="@string/inbound_ai_first_msg_default"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2"
                            android:maxLines="4"
                            android:padding="14dp"
                            android:textColor="@color/gunmetalTextGray"
                            android:textColorHint="@color/text_gray_hint"
                            android:textSize="14sp" />
                        <LinearLayout
                            android:id="@+id/inboundFirstMsgVarChips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal" />

                        <!-- Role / instructions -->
                        <View android:layout_width="match_parent" android:layout_height="24dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/inbound_ai_prompt_add_label"
                            android:textColor="@color/gunmetalTextGray"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/inbound_ai_prompt_add_hint"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp" />
                        <EditText
                            android:id="@+id/inboundPromptAdditionEt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/booking_input_bg"
                            android:gravity="top|start"
                            android:hint="@string/inbound_ai_prompt_add_hint_text"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="3"
                            android:maxLines="6"
                            android:padding="14dp"
                            android:textColor="@color/gunmetalTextGray"
                            android:textColorHint="@color/text_gray_hint"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ Rules card ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/darkMidnightBlue"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/booking_ai_rules_label"
                            android:textColor="@color/gunmetalTextGray"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/booking_ai_rules_hint"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp" />
                        <LinearLayout
                            android:id="@+id/inboundRulesList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/inboundAddRuleBtn"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:paddingStart="0dp"
                            android:text="@string/booking_ai_rule_add"
                            android:textAllCaps="false"
                            android:textColor="@color/colorPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ Advanced override card ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/darkMidnightBlue"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/inboundAdvancedToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/booking_ai_advanced_toggle"
                            android:textColor="@color/gunmetalTextGray"
                            android:textSize="14sp" />
                        <LinearLayout
                            android:id="@+id/inboundAdvancedGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/inbound_ai_advanced_hint"
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />
                            <EditText
                                android:id="@+id/inboundAdvancedEt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/booking_input_bg"
                                android:gravity="top|start"
                                android:hint="@string/booking_ai_advanced_label"
                                android:inputType="textMultiLine"
                                android:minLines="6"
                                android:maxLines="14"
                                android:padding="14dp"
                                android:textColor="@color/gunmetalTextGray"
                                android:textColorHint="@color/text_gray_hint"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ Activate + Save card ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/darkMidnightBlue"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/inboundActiveToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/inbound_ai_active_toggle"
                            android:textColor="@color/gunmetalTextGray"
                            android:textSize="14sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/inboundSaveBtn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="18dp"
                            android:text="@string/inbound_ai_save"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            app:backgroundTint="@color/colorPrimary"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
